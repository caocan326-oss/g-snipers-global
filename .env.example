# 复制为 .env 后按需修改。不要把真实密钥提交进仓库。

# --- 应用 ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
FRONTEND_ORIGIN=http://localhost:3000

# --- 数据库（docker compose 会覆盖为服务内地址）---
DATABASE_URL=postgresql+psycopg://gsnipers:gsnipers@localhost:5432/gsnipers

# --- 演示账号（seed 使用，可改）---
DEMO_AM_EMAIL=am@demo.local
DEMO_AM_PASSWORD=demo1234

# 本切片不接入 Google / Meta / SERP API。
# 洞察数据为工作区内存量；SEO 大纲/正文/Meta 为本地模板生成，供客户经理改稿。
