# 复制为 .env 后按需修改。不要把真实密钥提交进仓库。

# --- 应用 ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
FRONTEND_ORIGIN=http://localhost:3000

# --- 数据库（docker compose 会覆盖为服务内地址）---
DATABASE_URL=postgresql+psycopg://gsnipers:gsnipers@localhost:5432/gsnipers

# --- 演示账号（seed 使用。生产请关掉演示登录，并另设管理员）---
DEMO_AM_EMAIL=am@demo.gsnipers.com
DEMO_AM_PASSWORD=demo1234
DEMO_LOGIN_ENABLED=true

# --- 管理员（留空则不创建。密码只写本机/服务器 .env，不要提交）---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=管理员

# SEM / Google Ads / Meta 延后。不要配置 GOOGLE_ADS_*。
# 免费/自有数据源：GSC OAuth、PageSpeed、Bing、IndexNow 可按需启用。
# GSC_OAUTH_CLIENT_ID=
# GSC_OAUTH_CLIENT_SECRET=
# GSC_OAUTH_REDIRECT_URI=http://localhost:3000/onsite
# 生产（北京）必须配。浏览器授权仍直连 Google；换 token / 同步 / PageSpeed 走 Cloudflare Worker。
# 中转配上后测速不再走 17CE。步骤见 deploy/google-relay-worker/README.md。密钥不要提交。
# GOOGLE_RELAY_URL=https://g-snipers-google-relay.xxx.workers.dev
# GOOGLE_RELAY_KEY=
# GSC_AUTO_SYNC_DAYS=28
# GSC_AUTO_SYNC_MIN_INTERVAL_HOURS=24
# PAGESPEED_API_KEY=
# CE17_USER=
# CE17_API_PWD=
# BING_WEBMASTER_API_KEY=
# INDEXNOW_KEY=
# INDEXNOW_KEY_LOCATION=

# Bright Data Browser API。留空时仍用普通 HTTP 抓取；疑似 JS 空壳页会标记为需要 JS。
# 填 wss://... 后，仅对需要 JS 的页面做远程浏览器渲染复查。
# BRIGHTDATA_BROWSER_WS=
# ONSITE_RENDER_JS_ENABLED=true
# ONSITE_RENDER_TIMEOUT_MS=30000

# Bright Data SERP API。用于目标国家/关键词下的 Google 搜索结果观察。
# 在控制台 Web Access API 里建 SERP API 区，不要用浏览器区或 Dataset scrape。
# BRIGHTDATA_DATASET_API_KEY=
# BRIGHTDATA_SERP_ZONE=
# BRIGHTDATA_SERP_ENDPOINT=https://api.brightdata.com/request

# 分发渠道 Key 可留空；未配置时状态为「未配置」，确认后也不会真发。
# DISTRIBUTION_DIRECTORY_API_KEY=
# DISTRIBUTION_GUEST_API_KEY=
# DISTRIBUTION_SYNDICATION_API_KEY=

# 共享 LLM 网关（OpenAI 兼容）。留空则应用仍启动，AI 步骤返回未配置，不编造分析。
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# GEO 联网 AI 搜索 provider 预留。当前 DeepSeek/LLM 只做非联网分析，不计入真实 citation。
# PERPLEXITY_API_KEY=
# YOU_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=
