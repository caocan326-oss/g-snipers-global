# 2026-08-22 已装到 /etc/cron.d/g-snipers-backup（内容见 deploy/g-snipers-backup.cron）。
# 再装时仍用那份，不要带 Windows CRLF。
# BACKUP_SCHEDULE_ENABLED=true 只是状态标记，真正跑的是 cron。
# 每天 03:15 UTC 在生产仓库根目录打一份库副本。
# 15 3 * * * root cd /opt/g-snipers-overseas && /bin/sh deploy/backup-postgres.sh >> /var/log/g-snipers-backup.log 2>&1
